ui_print("======================================");
ui_print("  Framework patch");
ui_print("======================================");

ui_print(" Wiping package cache...");
run_program("/sbin/sh", "-c", "rm -rf /data/system/package_cache");

ui_print(" Mounting partitions...");
package_extract_file("META-INF/com/ks/mount.sh", "/tmp/mount.sh");
set_perm(0, 0, 0777, "/tmp/mount.sh");
run_program("/tmp/mount.sh", "");
delete("/tmp/mount.sh");
sleep(2);

ui_print(" Installing framework files...");
package_extract_dir("system_root", "/system_root");
package_extract_dir("system_ext", "/system_ext");
package_extract_dir("product", "/product");
package_extract_dir("vendor", "/vendor");

ui_print(" Clearing dalvik cache...");
run_program("/sbin/sh", "-c", "rm -rf /data/dalvik-cache /data/misc/apexdata/com.android.art/dalvik-cache");

ui_print(" Clearing boot artifacts...");
run_program("/sbin/sh", "-c", "rm -f /system_root/system/framework/boot-framework.vdex");
run_program("/sbin/sh", "-c", "rm -f /system_root/system/framework/arm/boot-framework.art /system_root/system/framework/arm/boot-framework.oat /system_root/system/framework/arm/boot-framework.vdex /system_root/system/framework/arm64/boot-framework.art /system_root/system/framework/arm64/boot-framework.oat /system_root/system/framework/arm64/boot-framework.vdex");
run_program("/sbin/sh", "-c", "rm -f /system_root/system/framework/oat/arm/services.art /system_root/system/framework/oat/arm/services.odex /system_root/system/framework/oat/arm/services.vdex /system_root/system/framework/oat/arm64/services.art /system_root/system/framework/oat/arm64/services.odex /system_root/system/framework/oat/arm64/services.vdex");

ui_print(" Unmounting...");
run_program("/sbin/busybox", "umount", "/system_root");

ui_print(" Done. Reboot your device.");
