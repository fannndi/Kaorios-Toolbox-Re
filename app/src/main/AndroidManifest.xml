<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Privileged-only, granted when the patch zip installs this APK into
         /system/priv-app (see zip/privapp-permissions-io.farewell.toolbox.xml):
         REBOOT gives reboot-to-recovery with no root, WRITE_SECURE_SETTINGS makes
         the config channel rootless too. Both are ignored on a normal install. -->
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:name=".FarewellApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/farewell_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FarewellToolbox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/farewell_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.AutoRefreshJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".core.NativeBootReceiver"
            android:directBootAware="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
